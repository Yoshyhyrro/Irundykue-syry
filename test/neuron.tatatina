\ ==============================================================================
\ neuron.tatatina
\ Irundykue-syry : Verified Singular Neuron Forward Pass
\ ==============================================================================

\ ------------------------------------------------------------------------------
\ 1. Dual-Path Operators (Strict Stack Semantics)
\ ------------------------------------------------------------------------------

\ Primary Operator (L_u): Standard Path
\ Stack: ( x w_u w_v -- y )
: MAC-NORMAL
  DROP                  \ Discard w_v -> ( x w_u )
  /                     \ Compute x / w_u. Triggers A/0 if w_u == 0!
;

\ Secondary Operator (L_v): Orthogonal Recovery
\ The singularity token (-10) is pushed on TOP of the stack.
\ Stack: ( x w_u w_v ext1 -- y' )
: EXT1-ACTIVATION
  *                     \ ext1 * w_v -> ( x w_u [ext1*w_v] )
  >R 2DROP R>           \ Discard x and w_u -> ( [ext1*w_v] )
;

\ ------------------------------------------------------------------------------
\ 2. The Singular Neuron Definition
\ ------------------------------------------------------------------------------

\ Forward pass of the Irundykue-syry neuron
\ Stack: ( x w_u w_v bias -- output )
: SINGULAR-NEURON
  \ Step 1: Scalar Dual-Path Execution (Pre-Ortho)
  >R                    \ Save bias to Return Stack -> ( x w_u w_v )
  ['] MAC-NORMAL ['] EXT1-ACTIVATION CO-EXECUTE
                        \ Evaluates to scalar y (either normal or spike) -> ( y )
  R>                    \ Retrieve bias -> ( y bias )

  \ Step 2: Form a 4D Clifford element on data stack
  \ Layout: ( y, bias, 0, 0 )
  0 0                   \ -> ( y bias 0 0 )

  \ Step 3: Elevate to Orthogonal Subspace (4-element quantization)
  \ Consumes exactly 4 elements. Data stack becomes empty.
  >ORTHO

  \ Step 4: Heisenberg Transaction & Contraction
  \ [H and ]H act as NOPs in QEMU runtime, verified statically by Idris 2.
  [H
    CL-CONTRACT         \ Project Clifford state into associative stability
  ]H

  \ Step 5: Extract stabilized scalar back to data stack
  ORTHO>                \ Restores ( y bias 0 0 ) to data stack
  DROP 2DROP            \ Drop higher components and bias -> ( y )
  
  \ (Note: bias can be added during Clifford projection or here)
;

\ ------------------------------------------------------------------------------
\ 3. Execution Stream & Deterministic Test Harness
\ ------------------------------------------------------------------------------

: RUN-TESTS
  \ Test Case 1: Non-Singular Path
  \ Inputs: x=10, w_u=2, w_v=5, bias=1
  \ Expected: 10 / 2 = 5 -> 5 + 1 = 6
  10 2 5 1 SINGULAR-NEURON
  ." Test 1 (Stable Path): " . CR

  \ Test Case 2: Singular Path (Spike Activation)
  \ Inputs: x=10, w_u=0, w_v=5, bias=1
  \ Math: 10 / 0 triggers A/0!
  \   -> Slips to EXT1-ACTIVATION with token = -10.
  \   -> -10 * 5 = -50
  \   -> Bias add: -50 + 1 = -49
  \ Expected: -49
  10 0 5 1 SINGULAR-NEURON
  ." Test 2 (Singular Spike): " . CR
;

\ Ignite the execution stream
RUN-TESTS